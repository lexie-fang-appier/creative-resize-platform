# Copy to .env.local for local dev. All values below are placeholders — no
# real secrets are committed. See README "What's real vs. what's stubbed".

# Local Postgres (docker compose up -d), or a Cloud SQL instance later.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/creative_resize_dev

# Google Workspace SSO (next-auth GoogleProvider). Create an OAuth client in the
# Appier GCP project's Console (APIs & Services > Credentials) — same place
# ai-tool-hub's client was created. Currently a placeholder.
GOOGLE_CLIENT_ID=replace-me.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-me

# next-auth session encryption secret — generate with `openssl rand -base64 32`.
NEXTAUTH_SECRET=replace-me
# Base URL next-auth uses for callbacks — http://localhost:3000 in dev.
NEXTAUTH_URL=http://localhost:3000

# OpenAI API key for image generation/edit (redesign candidates). Get from
# platform.openai.com — Lexie's own key or a team key, not yet decided (see
# 28 Technical Plan §22-Q10, OpenAI cost chargeback is still open).
OPENAI_API_KEY=replace-me

# Service account credentials JSON (stringified) for Google Drive read/write —
# read-only scope for client source folders, write scope for the output folder
# tree only (see 28 Technical Plan §6/§14). Create in the same GCP project as
# GOOGLE_CLIENT_ID above; download the JSON key and paste its contents here as
# a single-line string, or point this at a Secret Manager reference in
# production. Currently a placeholder.
GOOGLE_SERVICE_ACCOUNT_JSON=replace-me
